<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    >

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"

                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:fontFamily="@font/cairo_bold"
                    android:text="@string/hello"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/_14ssp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="@dimen/_60sdp"
                        android:layout_height="@dimen/_60sdp"
                        android:padding="@dimen/_10sdp"
                        android:src="@drawable/ic_profile" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:layout_weight="2"
                        android:gravity="start"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProfileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cairo_reqular"
                            android:text="@string/name"

                            android:textColor="@color/colorBlack"
                            android:textSize="@dimen/_10ssp" />

                        <TextView
                            android:id="@+id/tvProfileMobile"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cairo_reqular"
                            android:text="@string/mobile_number"
                            android:textColor="@color/colorBlack"
                            android:textSize="@dimen/_10ssp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEditProfile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_weight="1.5"
                        android:background="@drawable/shape_text_vie"
                        android:clickable="true"
                        android:drawablePadding="@dimen/_6sdp"
                        android:focusable="true"
                        android:fontFamily="@font/cairo_reqular"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="@dimen/_5sdp"
                        android:gravity="center"
                        android:text="@string/edit_account"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_10ssp"
                        app:drawableStartCompat="@drawable/ic_edit" />


                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/cairo_bold"
                    android:text="@string/account"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/_13ssp"
                    app:drawableStartCompat="@drawable/ic_vertical_indecator" />


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_10sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_10sdp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:drawablePadding="@dimen/_10sdp"
                            android:fontFamily="@font/cairo_bold"
                            android:gravity="center_vertical"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/orders"
                            android:textColor="@color/colorGrey3"
                            android:textSize="@dimen/_11ssp"
                            app:drawableStartCompat="@drawable/ic_icon_orders" />


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_1sdp"
                            android:background="@color/colorGrey" />

                        <RelativeLayout
                            android:id="@+id/rlWallet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginHorizontal="@dimen/_10sdp"
                                android:drawablePadding="@dimen/_10sdp"
                                android:fontFamily="@font/cairo_bold"
                                android:gravity="center_vertical"
                                android:padding="@dimen/_5sdp"
                                android:text="@string/wallet"
                                android:textColor="@color/colorGrey3"
                                android:textSize="@dimen/_11ssp"
                                app:drawableStartCompat="@drawable/ic_icon_portfolio" />

                            <TextView
                                android:id="@+id/tvWalletAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_gravity="end"
                                android:layout_marginHorizontal="@dimen/_5sdp"
                                android:fontFamily="@font/cairo_bold"
                                android:gravity="center"
                                android:padding="@dimen/_5sdp"
                                android:text="000.05"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/_10ssp" />

                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_1sdp"
                            android:background="@color/colorGrey" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginHorizontal="@dimen/_10sdp"
                                android:drawablePadding="@dimen/_10sdp"
                                android:fontFamily="@font/cairo_bold"
                                android:gravity="center_vertical"
                                android:padding="@dimen/_5sdp"
                                android:text="@string/cards"
                                android:textColor="@color/colorGrey3"
                                android:textSize="@dimen/_11ssp"
                                app:drawableStartCompat="@drawable/ic_icon_visa" />

                            <TextView
                                android:id="@+id/tvCardAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginHorizontal="@dimen/_5sdp"
                                android:layout_toStartOf="@+id/tvShowCard"
                                android:fontFamily="@font/cairo_bold"
                                android:gravity="center"
                                android:padding="@dimen/_5sdp"
                                android:text="0"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/_10ssp" />

                            <TextView
                                android:id="@+id/tvShowCard"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginHorizontal="@dimen/_5sdp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/ripple_square_btn"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/cairo_reqular"
                                android:foreground="?attr/selectableItemBackground"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/_5sdp"
                                android:text="@string/show_cards"
                                android:textColor="@color/colorWhite"
                                android:textSize="@dimen/_10ssp" />

                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_1sdp"
                            android:background="@color/colorGrey" />

                        <RelativeLayout
                            android:id="@+id/rvCoupons"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginHorizontal="@dimen/_10sdp"
                                android:drawablePadding="@dimen/_10sdp"
                                android:fontFamily="@font/cairo_bold"
                                android:gravity="center_vertical"
                                android:padding="@dimen/_5sdp"
                                android:text="@string/coupons"
                                android:textColor="@color/colorGrey3"
                                android:textSize="@dimen/_11ssp"
                                app:drawableStartCompat="@drawable/ic_icon_copon" />

                            <TextView
                                android:id="@+id/tvAddCoupon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginHorizontal="@dimen/_5sdp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:drawablePadding="@dimen/_5sdp"
                                android:focusable="true"
                                android:fontFamily="@font/cairo_bold"
                                android:gravity="center_vertical"
                                android:padding="@dimen/_5sdp"
                                android:text="@string/add_coupon"
                                android:layout_centerVertical="true"
                                android:textColor="@color/colorBlack"
                                android:textSize="@dimen/_8ssp"

                                app:drawableStartCompat="@drawable/ic_icon_add_copon"
                                app:drawableTint="@color/colorBlack" />

                        </RelativeLayout>


                    </LinearLayout>


                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:drawablePadding="@dimen/_5sdp"
                        android:fontFamily="@font/cairo_bold"
                        android:text="@string/notifications"
                        android:textColor="@color/colorBlack"
                        android:textSize="@dimen/_13ssp"
                        app:drawableStartCompat="@drawable/ic_vertical_indecator" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/_20sdp"
                        android:src="@drawable/ic_icon_above_arrow" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/_15sdp"
                        android:fontFamily="@font/cairo_bold"
                        android:gravity="center_vertical"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/orders_notifications"
                        android:textColor="@color/colorGrey3"
                        android:textSize="@dimen/_12ssp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swOrders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />


                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:background="@color/colorGrey" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/_15sdp"
                        android:fontFamily="@font/cairo_bold"
                        android:gravity="center_vertical"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/store_notifications"
                        android:textColor="@color/colorGrey3"
                        android:textSize="@dimen/_12ssp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swStores"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:background="@color/colorGrey" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/_15sdp"
                        android:fontFamily="@font/cairo_bold"
                        android:gravity="center_vertical"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/offer_notifications"
                        android:textColor="@color/colorGrey3"
                        android:textSize="@dimen/_12ssp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swOffers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:background="@color/colorGrey" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/cairo_bold"
                    android:text="@string/favorite_places"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/_13ssp"
                    app:drawableStartCompat="@drawable/ic_vertical_indecator" />


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_10sdp"
                    app:cardCornerRadius="@dimen/_10sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_5sdp"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_20sdp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_5sdp"
                            android:drawablePadding="@dimen/_10sdp"
                            android:fontFamily="@font/cairo_bold"
                            android:text="مطعم الروتس"
                            android:textColor="@color/colorGrey3"
                            android:textSize="@dimen/_10ssp"
                            app:drawableStartCompat="@drawable/ic_location" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_5sdp"
                            android:drawablePadding="@dimen/_10sdp"
                            android:fontFamily="@font/cairo_bold"
                            android:text="متجر الزين للملابس"
                            android:textColor="@color/colorGrey3"
                            android:textSize="@dimen/_10ssp"
                            app:drawableStartCompat="@drawable/ic_location" />
                    </LinearLayout>


                </androidx.cardview.widget.CardView>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/cairo_bold"
                        android:text="@string/request_price_offer"
                        android:textColor="@color/colorBlack"
                        android:textSize="@dimen/_13ssp" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="@dimen/_10sdp"
                        app:cardCornerRadius="@dimen/_5sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/shape_text_vie"
                            android:backgroundTint="@color/colorPrimaryDark"
                            android:clickable="true"
                            android:drawablePadding="@dimen/_10sdp"
                            android:focusable="true"
                            android:fontFamily="@font/cairo_bold"
                            android:foreground="?attr/selectableItemBackground"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:paddingVertical="@dimen/_3sdp"
                            android:text="@string/add_order"

                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/_10ssp"
                            app:drawableStartCompat="@drawable/ic_icon_add_copon" />

                    </androidx.cardview.widget.CardView>


                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|start"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/cairo_bold"
                        android:text="@string/connect_bot"
                        android:textColor="@color/colorBlack"
                        android:textSize="@dimen/_13ssp" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="@dimen/_10sdp"
                        app:cardCornerRadius="@dimen/_5sdp">

                        <TextView
                            android:id="@+id/tvStartChat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/shape_text_vie"
                            android:backgroundTint="@color/colorPrimaryDark"
                            android:clickable="true"
                            android:drawablePadding="@dimen/_10sdp"
                            android:focusable="true"
                            android:fontFamily="@font/cairo_bold"
                            android:foreground="?attr/selectableItemBackground"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:paddingVertical="@dimen/_3sdp"
                            android:text="@string/start_chat"

                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/_10ssp"
                            app:drawableStartCompat="@drawable/ic_icon_chat" />

                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/shape_light_green"
                    android:backgroundTint="@color/gray_light"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="@dimen/_5sdp"

                    >

                    <TextView
                        android:id="@+id/tv_settingsProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center_horizontal|start"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_toEndOf="@+id/icon"
                        android:drawablePadding="@dimen/_10sdp"
                        android:fontFamily="@font/cairo_reqular"
                        android:text="@string/settings"
                        android:textColor="@color/colorBlack"
                        android:textSize="@dimen/_13ssp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:src="@drawable/ic_icon_arrow_left"
                        app:tint="@color/colorBlack" />


                    <RelativeLayout
                        android:id="@+id/icon"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/shape_waiting_box">


                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_icon_settings"
                            app:tint="@color/colorWhite" />

                    </RelativeLayout>
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/shape_text_vie"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="@dimen/_10sdp">


                    <TextView
                        android:id="@+id/btnProfileLogout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@color/colorWhite"
                        android:clickable="false"
                        android:fontFamily="@font/cairo_bold"
                        android:text="@string/logout"
                        android:textColor="@color/colorPrimary" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:layout_toStartOf="@+id/btnProfileLogout"
                        android:src="@drawable/ic_logout" />


                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_100sdp"
                    android:layout_gravity="bottom"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:background="@drawable/shape_join_us"
                    android:elevation="@dimen/_2sdp"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="bottom|center"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:layout_marginBottom="@dimen/_20sdp"
                        android:drawablePadding="@dimen/_10sdp"
                        android:fontFamily="@font/cairo_bold"
                        android:text="@string/join_to_tatbeq"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_10ssp"
                        app:drawableStartCompat="@drawable/ic_icon_join_us" />

                </RelativeLayout>

            </LinearLayout>


        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>