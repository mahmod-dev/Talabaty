<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_15sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    app:cardCornerRadius="@dimen/_15sdp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/img"
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_80sdp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_order" />


                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_9sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMealName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/cairo_reqular"
                        android:text="@string/meal_name"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_8ssp" />

                    <TextView
                        android:id="@+id/tvNotice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/cairo_reqular"
                        android:text="@string/notice"
                        android:textColor="@color/colorGrey"
                        android:textSize="@dimen/_6ssp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp">

                        <TextView
                            android:id="@+id/tvResNameOrder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/_5sdp"
                            android:layout_toEndOf="@+id/imgSteps"
                            android:fontFamily="@font/cairo_reqular"
                            android:text="@string/rest_name"
                            android:textColor="@color/colorBlack"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:id="@+id/tvPlaceAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/tvResNameOrder"
                            android:layout_toEndOf="@+id/imgSteps"
                            android:fontFamily="@font/cairo_reqular"
                            android:text="@string/address"
                            android:textColor="@color/colorBlack"
                            android:textSize="@dimen/_8ssp" />

                        <ImageView
                            android:id="@+id/imgSteps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignTop="@+id/tvResNameOrder"
                            android:layout_alignBottom="@+id/tvPlaceAddress"

                            android:layout_marginEnd="@dimen/_5sdp"
                            android:src="@drawable/ic_vertical_steps" />
                    </RelativeLayout>


                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:fontFamily="@font/cairo_reqular"
                        android:text="20/6/2/2020"
                        android:textColor="@color/colorGrey"
                        android:textSize="@dimen/_8ssp" />


                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:background="@drawable/shape_light_green"
                        android:drawablePadding="@dimen/_8sdp"
                        android:fontFamily="@font/cairo_reqular"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/delivered"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_8ssp"
                        app:drawableStartCompat="@drawable/ic_true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:fontFamily="@font/cairo_reqular"
                            android:text="@string/order_num"

                            android:textColor="@color/colorBlack"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:id="@+id/tvOrderNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cairo_reqular"
                            android:text="###"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/_8ssp" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:fontFamily="@font/cairo_reqular"
                            android:text="@string/meals_num"
                            android:textColor="@color/colorBlack"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:id="@+id/tvMealNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cairo_reqular"
                            android:text="x1"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/_8ssp" />


                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:background="@color/colorGrey" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/tvPriceOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    android:background="@drawable/shape_waiting_box"
                    android:fontFamily="@font/cairo_reqular"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:paddingVertical="@dimen/_2sdp"
                    android:text="@string/price_rial"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_alignParentStart="true"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/_8sdp" />


                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDeleteOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    android:elevation="@dimen/_7sdp"
                    android:layout_alignParentEnd="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/colorWhite"
                    app:cardCornerRadius="@dimen/_4sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:drawablePadding="@dimen/_6sdp"
                        android:fontFamily="@font/cairo_reqular"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_2sdp"

                        android:text="@string/delete_order"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_8sdp"
                        app:drawableStartCompat="@drawable/ic_delete" />

                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    android:elevation="@dimen/_7sdp"
                    android:layout_toStartOf="@+id/cardDeleteOrder"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/colorWhite"
                    app:cardCornerRadius="@dimen/_4sdp">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:background="@drawable/shape_waiting_box"
                        android:backgroundTint="@color/colorWhite"
                        android:drawablePadding="@dimen/_6sdp"
                        android:fontFamily="@font/cairo_reqular"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_2sdp"
                        android:text="@string/re_order"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_8sdp"
                        app:drawableStartCompat="@drawable/ic_repeat"
                        app:drawableTint="@color/colorPrimary" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />


            </RelativeLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>