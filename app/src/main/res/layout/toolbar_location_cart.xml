<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_5sdp"
    android:layout_marginEnd="@dimen/_5sdp"
    android:background="@color/colorWhite"
    android:clipToPadding="false">


    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@android:color/transparent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/current_location"
                android:textColor="@color/colorGrey2"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/tvHomeLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvLocation"
                android:layout_centerHorizontal="true"
                android:drawablePadding="@dimen/_5sdp"
                android:fontFamily="@font/cairo_reqular"
                android:text="مكة المكرمة"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_8ssp"
                app:drawableEndCompat="@drawable/ic_tool_arrow"
                app:drawableStartCompat="@drawable/ic_tool_location" />


            <ImageView
                android:id="@+id/imgCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/tvHomeLocation"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/_5sdp"

                android:src="@drawable/ic_tool_cart" />

            <TextView
                android:id="@+id/tvCartNum"
                android:layout_width="@dimen/_8sdp"
                android:layout_height="@dimen/_8sdp"
                android:layout_alignBottom="@+id/tvHomeLocation"
                android:layout_marginEnd="-20dp"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/_3sdp"
                android:layout_toStartOf="@+id/imgCart"
                android:background="@drawable/ripple_square_btn"
                android:backgroundTint="@color/cart_num"
                android:gravity="center"
                android:text="5"
                android:textStyle="bold"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_6ssp" />


        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>


</RelativeLayout>