<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_5sdp"
    android:layout_marginEnd="@dimen/_5sdp"
    android:background="@color/colorWhite"
    android:clipToPadding="false">


        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_centerInParent="true"
            android:background="@android:color/transparent"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/cairo_bold"
                    android:text="@string/current_location"
                    android:textColor="@color/colorGrey2"
                    android:textSize="@dimen/_10ssp" />

                <TextView
                    android:id="@+id/tvHomeLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvLocation"
                    android:layout_centerHorizontal="true"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/cairo_reqular"
                    android:text="مكة المكرمة"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/_10sdp"
                    app:drawableEndCompat="@drawable/ic_tool_arrow"
                    app:drawableStartCompat="@drawable/ic_tool_location" />


                <ImageView
                    android:id="@+id/imgHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignBottom="@+id/tvHomeLocation"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:padding="@dimen/_5sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"

                    android:src="@drawable/ic_tool_cart" />

                <ImageView
                    android:id="@+id/imgArrowBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvLocation"
                    android:layout_alignBottom="@+id/tvHomeLocation"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:focusable="true"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_10sdp"

                    android:src="@drawable/ic_icon_arrow_left"
                    app:tint="@color/colorPrimary" />

            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>



</RelativeLayout>